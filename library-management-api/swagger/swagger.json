{
  "openapi": "3.0.0",
  "info": {
    "title": "Library Management API",
    "version": "2.0.0",
    "description": "Library Management API with MongoDB CRUD operations and JWT authentication"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "username",
          "email",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "email": {
            "type": "string",
            "example": "admin@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        }
      },
      "Book": {
        "type": "object",
        "required": [
          "title",
          "isbn",
          "author",
          "category",
          "publisher",
          "publicationYear",
          "pages",
          "available"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "The Hobbit"
          },
          "isbn": {
            "type": "string",
            "example": "9780261103344"
          },
          "author": {
            "type": "string",
            "example": "J.R.R. Tolkien"
          },
          "category": {
            "type": "string",
            "example": "Fantasy"
          },
          "publisher": {
            "type": "string",
            "example": "HarperCollins"
          },
          "publicationYear": {
            "type": "integer",
            "example": 1937
          },
          "pages": {
            "type": "integer",
            "example": 310
          },
          "available": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Author": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "birthYear",
          "country",
          "email"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "example": "J.R.R."
          },
          "lastName": {
            "type": "string",
            "example": "Tolkien"
          },
          "birthYear": {
            "type": "integer",
            "example": 1892
          },
          "country": {
            "type": "string",
            "example": "United Kingdom"
          },
          "email": {
            "type": "string",
            "example": "tolkien@example.com"
          }
        }
      }
    }
  },


  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "User already exists"
          }
        }
      }
    },

    "/auth/login": {
      "post": {
        "summary": "Login user",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "admin@gmail.com",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },

    "/auth/logout": {
      "post": {
        "summary": "Logout user",
        "tags": [
          "Authentication"
        ],
"security": [
  {
    "bearerAuth": []
  }
],
        "responses": {
          "200": {
            "description": "Logout successful"
          }
        }
      }
    },

    "/books": {
      "get": {
        "summary": "Get all books",
        "tags": [
          "Books"
        ],
        "responses": {
          "200": {
            "description": "Books returned successfully"
          }
        }
      },
      "post": {
        "summary": "Create a new book",
        "tags": [
          "Books"
        ],
        "security": [
  {
    "bearerAuth": []
  }
],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Book"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Book created successfully"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },

    "/books/{id}": {
      "get": {
        "summary": "Get a single book",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book returned successfully"
          },
          "404": {
            "description": "Book not found"
          }
        }
      },
      "put": {
        "summary": "Update a book",
        "tags": [
          "Books"
        ],

        "security": [
  {
    "bearerAuth": []
  }
],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Book"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Book updated successfully"
          }
        }
      },
      "delete": {
        "summary": "Delete a book",
        "tags": [
          "Books"
        ],

        "security": [
  {
    "bearerAuth": []
  }
],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book deleted successfully"
          }
        }
      }
    },

    "/authors": {
      "get": {
        "summary": "Get all authors",
        "tags": [
          "Authors"
        ],
        "responses": {
          "200": {
            "description": "Authors returned successfully"
          }
        }
      },
      "post": {
        "summary": "Create a new author",
        "tags": [
          "Authors"
        ],

        "security": [
  {
    "bearerAuth": []
  }
],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Author"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Author created successfully"
          }
        }
      }
    },

    "/authors/{id}": {
      "get": {
        "summary": "Get a single author",
        "tags": [
          "Authors"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Author returned successfully"
          }
        }
      },
      "put": {
        "summary": "Update an author",
        "tags": [
          "Authors"
        ],

        "security": [
  {
    "bearerAuth": []
  }
],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Author"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Author updated successfully"
          }
        }
      },
      "delete": {
        "summary": "Delete an author",
        "tags": [
          "Authors"
        ],

        "security": [
  {
    "bearerAuth": []
  }
],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Author deleted successfully"
          }
        }
      }
    }
  }
}