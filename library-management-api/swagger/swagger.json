{
  "openapi": "3.0.0",
  "info": {
    "title": "Library Management API",
    "version": "3.0.0",
    "description": "Library Management API with MongoDB CRUD operations, data validation, JWT authorization, Google OAuth authentication, and automated testing."
  },

  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    },
    {
      "url": "https://cse341-d605.onrender.com",
      "description": "Production Server on Render"
    }
  ],

  "tags": [
    {
      "name": "Authentication",
      "description": "User registration, login, logout, and Google OAuth authentication"
    },
    {
      "name": "Books",
      "description": "Book management operations"
    },
    {
      "name": "Authors",
      "description": "Author management operations"
    },
    {
      "name": "Members",
      "description": "Library member management operations"
    },
    {
      "name": "Loans",
      "description": "Library loan management operations"
    }
  ],

  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter ONLY your JWT token. Do not type 'Bearer'. Swagger UI automatically adds 'Bearer'."
      }
    },

    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@gmail.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "password123"
          }
        }
      },

      "Login": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@gmail.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "password123"
          }
        }
      },

      "Book": {
        "type": "object",
        "required": [
          "title",
          "isbn",
          "author",
          "category",
          "publisher",
          "publicationYear",
          "pages",
          "language",
          "available"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "readOnly": true,
            "example": "66a123456789abcdef123456"
          },
          "title": {
            "type": "string",
            "example": "Pride and Prejudice"
          },
          "isbn": {
            "type": "string",
            "example": "9780141439518"
          },
          "author": {
            "type": "string",
            "example": "Jane Austen"
          },
          "category": {
            "type": "string",
            "example": "Classic"
          },
          "publisher": {
            "type": "string",
            "example": "Penguin Classics"
          },
          "publicationYear": {
            "type": "integer",
            "example": 1813
          },
          "pages": {
            "type": "integer",
            "example": 432
          },
          "language": {
            "type": "string",
            "example": "English"
          },
          "available": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },

      "Author": {
        "type": "object",
        "required": [
          "name",
          "email",
          "nationality",
          "birthYear",
          "biography"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "readOnly": true,
            "example": "66a123456789abcdef123456"
          },
          "name": {
            "type": "string",
            "example": "Jane Austen"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "jane.austen@example.com"
          },
          "nationality": {
            "type": "string",
            "example": "British"
          },
          "birthYear": {
            "type": "integer",
            "example": 1775
          },
          "biography": {
            "type": "string",
            "example": "English novelist known for her novels about British society and relationships."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },

      "Member": {
        "type": "object",
        "required": [
          "name",
          "email",
          "phone",
          "membershipType",
          "joinDate",
          "address",
          "active"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "readOnly": true,
            "example": "66a123456789abcdef123456"
          },
          "name": {
            "type": "string",
            "example": "John Smith"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "phone": {
            "type": "string",
            "example": "555-123-4567"
          },
          "membershipType": {
            "type": "string",
            "enum": [
              "standard",
              "premium",
              "student"
            ],
            "example": "standard"
          },
          "joinDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-08"
          },
          "address": {
            "type": "string",
            "example": "123 Main Street"
          },
          "active": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },

      "Loan": {
        "type": "object",
        "required": [
          "member",
          "book",
          "loanDate",
          "dueDate",
          "status",
          "fine"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "readOnly": true,
            "example": "66a123456789abcdef123456"
          },
          "member": {
            "type": "string",
            "example": "66a123456789abcdef123456"
          },
          "book": {
            "type": "string",
            "example": "66a123456789abcdef654321"
          },
          "loanDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-08"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-22"
          },
          "returnDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": null
          },
          "status": {
            "type": "string",
            "enum": [
              "borrowed",
              "returned",
              "overdue"
            ],
            "example": "borrowed"
          },
          "fine": {
            "type": "number",
            "minimum": 0,
            "example": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },

      "AuthResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Login successful"
          },
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },

      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Authentication required"
          }
        }
      }
    }
  },

  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "description": "Creates a new user account. Authentication is not required.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "User already exists or validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },

    "/auth/login": {
      "post": {
        "summary": "Login user",
        "description": "Authenticates a user and returns a JWT token. Authentication is not required.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful and JWT token returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },

    "/auth/logout": {
      "post": {
        "summary": "Logout user",
        "description": "Logs out an authenticated user. JWT authentication is required.",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout successful"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },

    "/auth/google": {
      "get": {
        "summary": "Login using Google OAuth",
        "description": "Redirects the user to Google for OAuth authentication.",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "302": {
            "description": "Redirect to Google OAuth"
          },
          "500": {
            "description": "OAuth configuration error"
          }
        }
      }
    },

    "/auth/google/callback": {
      "get": {
        "summary": "Google OAuth callback",
        "description": "Handles the callback from Google after successful OAuth authentication.",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Google OAuth authentication successful"
          },
          "401": {
            "description": "OAuth authentication failed"
          },
          "500": {
            "description": "OAuth server error"
          }
        }
      }
    },

    "/books": {
