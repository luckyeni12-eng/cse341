    "/books/{id}": {
      "get": {
        "summary": "Get a single book",
        "description": "Returns one book by MongoDB ID. Authentication is NOT required.",
        "tags": [
          "Books"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB book ID",
            "schema": {
              "type": "string",
              "example": "66a123456789abcdef123456"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book returned successfully",
            "content": {
              "application/json": {
                "schema": {
