          },
          "400": {
            "description": "Invalid book ID"
          },
          "404": {
            "description": "Book not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },

      "put": {
        "summary": "Update a book",
        "description": "Updates an existing book. JWT authentication is required.",
        "tags": [
          "Books"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "MongoDB book ID",
            "schema": {
              "type": "string",
              "example": "66a123456789abcdef123456"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Book"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Book updated successfully"
          },
          "400": {
            "description": "Validation error or invalid book ID"
          },
          "401": {
            "description": "Authentication required or invalid token"
          },
          "404": {
            "description": "Book not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },

      "delete": {
        "summary": "Delete a book",
        "description": "Deletes an existing book. JWT authentication is required.",
        "tags": [
          "Books"
        ],
        "security": [
          {
