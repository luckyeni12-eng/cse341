{
  "openapi": "3.0.0",
  "info": {
    "title": "Library Management API",
    "version": "3.0.0",
    "description": "Library Management API with MongoDB CRUD operations, data validation, JWT authorization, Google OAuth authentication, and automated testing."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    },
    {
      "url": "https://cse341-d605.onrender.com",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@gmail.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "password123"
          }
        }
      },
      "Book": {
        "type": "object",
        "required": [
          "title",
          "isbn",
          "author",
          "category",
          "publisher",
          "publicationYear",
          "pages",
          "language",
          "available"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "The Hobbit"
          },
          "isbn": {
            "type": "string",
            "example": "9780261103344"
          },
          "author": {
            "type": "string",
            "example": "J.R.R. Tolkien"
          },
          "category": {
            "type": "string",
            "example": "Fantasy"
          },
          "publisher": {
            "type": "string",
            "example": "HarperCollins"
          },
          "publicationYear": {
            "type": "integer",
            "example": 1937
          },
          "pages": {
            "type": "integer",
            "example": 310
          },
          "language": {
            "type": "string",
            "example": "English"
          },
          "available": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Author": {
        "type": "object",
        "required": [
          "firstName",
          "lastName",
          "birthYear",
          "country",
          "email"
        ],
        "properties": {
          "firstName": {
            "type": "string",
            "example": "J.R.R."
          },
          "lastName": {
            "type": "string",
            "example": "Tolkien"
          },
          "birthYear": {
            "type": "integer",
            "example": 1892
          },
          "country": {
            "type": "string",
            "example": "United Kingdom"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "tolkien@example.com"
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "name",
          "email",
          "phone",
          "membershipType",
          "joinDate",
          "address",
          "active"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "John Smith"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "phone": {
            "type": "string",
            "example": "555-123-4567"
          },
          "membershipType": {
            "type": "string",
            "enum": [
              "standard",
              "premium",
              "student"
            ],
            "example": "standard"
          },
          "joinDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-08"
          },
          "address": {
            "type": "string",
            "example": "123 Main Street"
          },
          "active": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Loan": {
        "type": "object",
        "required": [
          "member",
          "book",
          "loanDate",
          "dueDate",
          "status",
          "fine"
        ],
        "properties": {
          "member": {
            "type": "string",
            "example": "66a123456789abcdef123456"
          },
          "book": {
            "type": "string",
            "example": "66a123456789abcdef654321"
          },
          "loanDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-08"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "example": "2026-08-22"
          },
          "returnDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": null
          },
          "status": {
            "type": "string",
            "enum": [
              "borrowed",
              "returned",
              "overdue"
            ],
            "example": "borrowed"
          },
          "fine": {
            "type": "number",
            "minimum": 0,
            "example": 0
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "User already exists or validation failed"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "admin@gmail.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful and JWT token returned"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout user",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout successful"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/auth/google": {
      "get": {
        "summary": "Login using Google OAuth",
        "description": "Redirects the user to Google for OAuth authentication.",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "302": {
            "description": "Redirect to Google OAuth"
          },
          "500": {
            "description": "OAuth configuration error"
          }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "summary": "Google OAuth callback",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Google OAuth authentication successful and JWT token returned"
          },
          "401": {
            "description": "OAuth authentication failed"
          },
          "500": {
            "description": "OAuth server error"
          }
        }
      }
    },
